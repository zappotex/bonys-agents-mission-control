# Bony's Agents Mission Control – Einstellungen für deploy/compose.yaml.
# Die Installation kopiert diese Datei nach /opt/bonys-mission-control/.env (nur für root lesbar).
# Keine echten Geheimnisse hier eintragen: Werte "__GENERATE__" ersetzt scripts/ensure-secrets.sh
# beim ersten Start durch Zufallswerte.

# Release-Version des Images (wird von install.sh / update.sh gesetzt)
MISSION_CONTROL_VERSION=0.2.5
MISSION_CONTROL_IMAGE=ghcr.io/zappotex/bonys-agents-mission-control

# Port der Weboberfläche, nur an 127.0.0.1 gebunden
MISSION_CONTROL_PORT=8787

# Aktives Teamprofil (mitgeliefert oder eigenes im Daten-Volume unter profiles/)
MISSION_CONTROL_PROFILE=bonys-agents.example.yaml
MISSION_CONTROL_SHOW_PRIVATE=false

# Geheimnisse – werden automatisch erzeugt
# Token für schreibende API-Zugriffe außerhalb von Loopback
MISSION_CONTROL_API_TOKEN=__GENERATE__
